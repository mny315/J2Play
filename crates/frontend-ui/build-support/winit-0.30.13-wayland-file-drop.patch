+//! Bounded, nonblocking text/uri-list decoding. No files are opened here.
+
+use std::ffi::OsString;
+use std::io::{self, Read};
+use std::os::unix::ffi::OsStringExt;
+use std::path::PathBuf;
+
+const MAX_BYTES: usize = 256 * 1024;
+const MAX_FILES: usize = 64;
+const MAX_PATH: usize = 16 * 1024;
+
+pub(super) fn read_uris(
+    reader: &mut impl Read,
+    bytes: &mut Vec<u8>,
+) -> io::Result<Option<Vec<PathBuf>>> {
+    let mut chunk = [0; 4096];
+    // A continuously writing source must still yield to the window event loop.
+    for _ in 0..32 {
+        match reader.read(&mut chunk) {
+            Ok(0) => return parse_uris(bytes).map(Some),
+            Ok(count) => {
+                if bytes.len() + count > MAX_BYTES {
+                    return Err(invalid());
+                }
+                bytes.extend_from_slice(&chunk[..count]);
+            }
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => return Ok(None),
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(None)
+}
+
+fn parse_uris(bytes: &[u8]) -> io::Result<Vec<PathBuf>> {
+    let mut paths = Vec::new();
+    for line in bytes.split(|byte| *byte == b'\n') {
+        let line = line.strip_suffix(b"\r").unwrap_or(line);
+        if line.is_empty() || line.starts_with(b"#") {
+            continue;
+        }
+        if paths.len() == MAX_FILES || line.len() > MAX_PATH * 3 + 20 {
+            return Err(invalid());
+        }
+        let uri = line.strip_prefix(b"file://").ok_or_else(invalid)?;
+        // Keep the leading slash for localhost authorities as well.
+        let uri = if line.starts_with(b"file://localhost/") {
+            &line[b"file://localhost".len()..]
+        } else {
+            uri
+        };
+        if !uri.starts_with(b"/") || uri.iter().any(|byte| matches!(byte, b'?' | b'#' | 0)) {
+            return Err(invalid());
+        }
+        let mut decoded = Vec::new();
+        let mut index = 0;
+        while index < uri.len() {
+            let byte = if uri[index] == b'%' {
+                let pair = uri.get(index + 1..index + 3).ok_or_else(invalid)?;
+                let hi = (pair[0] as char).to_digit(16).ok_or_else(invalid)?;
+                let lo = (pair[1] as char).to_digit(16).ok_or_else(invalid)?;
+                index += 3;
+                (hi * 16 + lo) as u8
+            } else {
+                index += 1;
+                uri[index - 1]
+            };
+            if byte == 0 || decoded.len() == MAX_PATH {
+                return Err(invalid());
+            }
+            decoded.push(byte);
+        }
+        paths.push(PathBuf::from(OsString::from_vec(decoded)));
+    }
+    if paths.is_empty() {
+        return Err(invalid());
+    }
+    Ok(paths)
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "invalid or oversized local file drop",
+    )
+}
