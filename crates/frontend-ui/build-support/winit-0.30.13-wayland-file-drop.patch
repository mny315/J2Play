--- a/src/platform_impl/linux/wayland/file_drop.rs
+++ b/src/platform_impl/linux/wayland/file_drop.rs
@@ -0,0 +1,161 @@
+//! Local file drops using the same Wayland connection as the window.
+
+use std::time::{Duration, Instant};
+
+use sctk::data_device_manager::{
+    data_device::{DataDeviceData, DataDeviceHandler},
+    data_offer::{DataOfferData, DataOfferHandler, DragOffer},
+    DataDeviceManagerState, ReadPipe,
+};
+use sctk::globals::GlobalData;
+use sctk::reexports::calloop::timer::{TimeoutAction, Timer};
+use sctk::reexports::client::{
+    delegate_dispatch,
+    protocol::{
+        wl_data_device::WlDataDevice,
+        wl_data_device_manager::{DndAction, WlDataDeviceManager},
+        wl_data_offer::WlDataOffer,
+        wl_surface::WlSurface,
+    },
+    Connection, Proxy, QueueHandle,
+};
+
+use super::{file_drop_read::read_uris, make_wid, state::WinitState};
+use crate::event::WindowEvent;
+
+const MIME: &str = "text/uri-list";
+
+struct Transfer {
+    offer: DragOffer,
+    pipe: ReadPipe,
+    bytes: Vec<u8>,
+    deadline: Instant,
+}
+
+impl Drop for Transfer {
+    fn drop(&mut self) {
+        if self.offer.inner().is_alive() {
+            self.offer.destroy();
+        }
+    }
+}
+
+fn offer(device: &WlDataDevice) -> Option<DragOffer> {
+    device.data::<DataDeviceData>()?.drag_offer()
+}
+
+impl DataDeviceHandler for WinitState {
+    fn enter(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        device: &WlDataDevice,
+        _: f64,
+        _: f64,
+        surface: &WlSurface,
+    ) {
+        if let Some(offer) = offer(device) {
+            let accepted = self.file_drop.is_none()
+                && self.windows.get_mut().contains_key(&make_wid(surface))
+                && offer.with_mime_types(|types| types.iter().any(|mime| mime == MIME));
+            offer.accept_mime_type(offer.serial, accepted.then(|| MIME.to_owned()));
+            offer.set_actions(DndAction::Copy, DndAction::Copy);
+        }
+    }
+
+    fn leave(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &WlDataDevice) {}
+
+    fn motion(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &WlDataDevice, _: f64, _: f64) {}
+
+    // Clipboard selection is handled by egui's clipboard adapter.
+    fn selection(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &WlDataDevice) {}
+
+    fn drop_performed(&mut self, _: &Connection, _: &QueueHandle<Self>, device: &WlDataDevice) {
+        let Some(offer) = offer(device) else { return };
+        let window = make_wid(&offer.surface);
+        if self.file_drop.is_some()
+            || !self.windows.get_mut().contains_key(&window)
+            || !offer.with_mime_types(|types| types.iter().any(|mime| mime == MIME))
+            || (offer.inner().version() >= 3 && offer.selected_action != DndAction::Copy)
+        {
+            offer.destroy();
+            return;
+        }
+        let pipe = match offer.receive(MIME.to_owned()) {
+            Ok(pipe) => pipe,
+            Err(_) => {
+                offer.destroy();
+                tracing::warn!("Could not receive Wayland file drop");
+                return;
+            }
+        };
+        let mut transfer = Transfer {
+            offer,
+            pipe,
+            bytes: Vec::new(),
+            deadline: Instant::now() + Duration::from_secs(2),
+        };
+        let nonblocking = rustix::fs::fcntl_getfl(&transfer.pipe).and_then(|flags| {
+            rustix::fs::fcntl_setfl(&transfer.pipe, flags | rustix::fs::OFlags::NONBLOCK)
+        });
+        if nonblocking.is_err() {
+            tracing::warn!("Could not configure Wayland file drop pipe");
+            return;
+        }
+        // The timer owns the pipe and offer: no detached I/O thread survives
+        // cancellation or event-loop destruction. Read callbacks stay bounded.
+        self.file_drop = self
+            .loop_handle
+            .insert_source(Timer::immediate(), move |_, _, state| {
+                if Instant::now() >= transfer.deadline
+                    || !state.windows.get_mut().contains_key(&window)
+                    || !transfer.offer.inner().is_alive()
+                {
+                    state.file_drop = None;
+                    tracing::warn!("Wayland file drop cancelled or timed out");
+                    return TimeoutAction::Drop;
+                }
+                match read_uris(&mut transfer.pipe, &mut transfer.bytes) {
+                    Ok(None) => return TimeoutAction::ToDuration(Duration::from_millis(10)),
+                    Ok(Some(paths)) => {
+                        transfer.offer.finish();
+                        for path in paths {
+                            state
+                                .events_sink
+                                .push_window_event(WindowEvent::DroppedFile(path), window);
+                        }
+                        state.dispatched_events = true;
+                    }
+                    Err(_) => tracing::warn!("Invalid or oversized Wayland file drop"),
+                }
+                state.file_drop = None;
+                TimeoutAction::Drop
+            })
+            .ok();
+    }
+}
+
+impl DataOfferHandler for WinitState {
+    fn source_actions(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &mut DragOffer,
+        _: DndAction,
+    ) {
+    }
+
+    fn selected_action(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &mut DragOffer,
+        _: DndAction,
+    ) {
+    }
+}
+
+// Only receive data; this adapter never creates a data source or changes the clipboard.
+delegate_dispatch!(WinitState: [WlDataDeviceManager: GlobalData] => DataDeviceManagerState);
+delegate_dispatch!(WinitState: [WlDataDevice: DataDeviceData] => DataDeviceManagerState);
+delegate_dispatch!(WinitState: [WlDataOffer: DataOfferData] => DataDeviceManagerState);
