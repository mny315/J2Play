+    fn stop_motion(&mut self) {
+        self.vel = Vec2::ZERO;
+        self.drag_velocity = (Vec2::ZERO, f64::NEG_INFINITY);
+        self.edge_offset = Vec2::ZERO;
+        self.edge_velocity = Vec2::ZERO;
