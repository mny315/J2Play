+        // Exact critically damped spring: independent of refresh rate, no oscillation.
+        let decay = (-18.0 * dt).exp();
+        let b = self.edge_velocity[d] + 18.0 * self.edge_offset[d];
+        self.edge_offset[d] = (self.edge_offset[d] + b * dt) * decay;
+        self.edge_velocity[d] = (self.edge_velocity[d] - 18.0 * b * dt) * decay;
+        if self.edge_offset[d].abs() < 0.1 && self.edge_velocity[d].abs() < 2.0 {
+            self.edge_offset[d] = 0.0;
+            self.edge_velocity[d] = 0.0;
+            false
+        } else {
+            true
+        }
+    }
