+
+    fn drag_content(&mut self, d: usize, mut delta: f32, max_offset: f32, limit: f32) {
+        self.vel[d] = 0.0;
+        self.edge_velocity[d] = 0.0;
+        if self.edge_offset[d] != 0.0 {
+            let previous = self.edge_offset[d];
+            let resistance = if delta * previous >= 0.0 {
+                0.4 * (1.0 - previous.abs() / limit).max(0.0)
+            } else {
+                0.4
+            };
+            let next = previous + delta * resistance;
+            if next * previous > 0.0 {
+                self.edge_offset[d] = next.clamp(-limit, limit);
+                return;
+            }
+            // Consume the return to the edge before scrolling into the content.
+            delta = next / resistance;
+            self.edge_offset[d] = 0.0;
+        }
+        let offset = self.offset[d] - delta;
+        self.offset[d] = offset.clamp(0.0, max_offset);
+        self.edge_offset[d] = ((self.offset[d] - offset) * 0.4).clamp(-limit, limit);
+    }
+
