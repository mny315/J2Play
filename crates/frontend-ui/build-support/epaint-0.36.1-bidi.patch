+/// Apply Unicode bidi after wrapping, with shaper clusters kept indivisible.
+fn reorder_bidi_rows(rows: &mut [PlacedRow]) {
+    let mut paragraph_start = 0;
+    while paragraph_start < rows.len() {
+        let paragraph_end = rows[paragraph_start..].iter()
+            .position(|row| row.ends_with_newline)
+            .map_or(rows.len(), |end| paragraph_start + end + 1);
+        let text: String = rows[paragraph_start..paragraph_end].iter()
+            .flat_map(|row| row.glyphs.iter().map(|glyph| glyph.chr)).collect();
+        let bidi = unicode_bidi::BidiInfo::new(&text, None);
+        if bidi.has_rtl() {
+            if let Some(paragraph) = bidi.paragraphs.first() {
+                let mut byte_start = 0;
+                let mut char_start = 0;
+                for placed in &mut rows[paragraph_start..paragraph_end] {
+                    let row = Arc::make_mut(&mut placed.row);
+                    let byte_end = byte_start + row.glyphs.iter().map(|g| g.chr.len_utf8()).sum::<usize>();
+                    let levels = bidi.reordered_levels_per_char(paragraph, byte_start..byte_end);
+                    let mut groups: Vec<Range<usize>> = Vec::new();
+                    for (index, glyph) in row.glyphs.iter().enumerate() {
+                        if glyph.cluster_start || groups.is_empty() {
+                            groups.push(index..index + 1);
+                        } else {
+                            groups.last_mut().unwrap().end = index + 1;
+                        }
+                    }
+                    let group_levels: Vec<_> = groups.iter().map(|range| levels[char_start + range.start]).collect();
+                    let order = unicode_bidi::BidiInfo::reorder_visual(&group_levels);
+                    let original: Vec<_> = row.glyphs.iter().map(|g| g.pos.x).collect();
+                    let mut origins = Vec::with_capacity(groups.len());
+                    let mut widths = Vec::with_capacity(groups.len());
+                    let mut logical_x = 0.0;
+                    for range in &groups {
+                        origins.push(logical_x);
+                        let width: f32 = row.glyphs[range.clone()].iter().map(|g| g.advance_width).sum();
+                        widths.push(width);
+                        logical_x += width;
+                    }
+                    let mut visual_x = 0.0;
+                    for index in order {
+                        for glyph_index in groups[index].clone() {
+                            let glyph = &mut row.glyphs[glyph_index];
+                            glyph.pos.x = visual_x + original[glyph_index] - origins[index];
+                            glyph.bidi_rtl = group_levels[index].is_rtl();
+                        }
+                        visual_x += widths[index];
+                    }
+                    byte_start = byte_end;
+                    char_start += row.glyphs.len();
+                }
+            }
+        }
+        paragraph_start = paragraph_end;
+    }
